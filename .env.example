# Postgres (local cluster from `pnpm db:start`)
DATABASE_URL=postgres://postgres@localhost:54329/tmc
# Used by integration/e2e tests
TEST_DATABASE_URL=postgres://postgres@localhost:54329/tmc_test
# Better Auth
BETTER_AUTH_SECRET=change-me-to-a-long-random-string-at-least-32-chars
BETTER_AUTH_URL=http://localhost:3000
# HMAC key for OTP hashes
OTP_SECRET=change-me-another-long-random-string
# Shared secret for the /api/cron/tick endpoint (Vercel Cron / Cloud Scheduler)
CRON_SECRET=change-me-cron-secret
# "true" shows the demo persona picker and the dev outbox (never in a real-customer deployment)
DEMO_MODE=true
# Messaging: "outbox" (log only, default) or "live"
MESSAGING_MODE=outbox
UNIFONIC_APP_SID=
UNIFONIC_SENDER_ID=
SMTP_URL=
MAIL_FROM="TagMyCredit <no-reply@tagmycredit.com>"
